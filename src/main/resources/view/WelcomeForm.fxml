<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.InnerShadow?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.welcomeController.WelcomeFormController">

    <children>
        <Label layoutX="0.0" layoutY="0.0" prefHeight="500.0" prefWidth="600.0"
               style="-fx-background-color: linear-gradient(to bottom right, #4e54c8, #8f94fb);" />

        <VBox layoutX="100.0" layoutY="80.0" spacing="25.0" alignment="CENTER" prefWidth="400.0"
              style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 20; -fx-padding: 35;">

            <effect>
                <DropShadow color="#000000" radius="15.0" offsetX="0.0" offsetY="5.0"/>
            </effect>

            <Label text="Dashboard" textFill="WHITE" alignment="CENTER">
                <font>
                    <Font name="Arial Bold" size="30.0"/>
                </font>
                <effect>
                    <DropShadow color="#000000" radius="5.0"/>
                </effect>
            </Label>

            <TextField fx:id="txtFirstName" prefHeight="35.0" prefWidth="300.0" promptText="First Name"
                       style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 0 10 0 10; -fx-border-color: #ffffff; -fx-border-width: 1px;" />
            
            <Button text="Log Out" onAction="#btnOnActionLogOut" prefWidth="160.0" prefHeight="40.0"
                    style="-fx-background-color: #2575fc; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-weight: bold;">
                <effect>
                    <InnerShadow radius="5" color="#000000"/>
                </effect>
            </Button>
        </VBox>
    </children>
</AnchorPane>
