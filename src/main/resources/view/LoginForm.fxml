<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.loginController.LoginFormController">

    <!-- Background gradient -->
    <children>
        <Label layoutX="0.0" layoutY="0.0" prefHeight="500.0" prefWidth="600.0"
               style="-fx-background-color: linear-gradient(to bottom right, #4e54c8, #8f94fb);" />

        <!-- Main VBox for centered content -->
        <VBox layoutX="150.0" layoutY="80.0" spacing="20.0" alignment="CENTER" prefWidth="300.0">

            <!-- Title -->
            <Label text="Welcome Back!" textFill="WHITE" alignment="CENTER">
                <font>
                    <Font name="Arial Bold" size="36.0"/>
                </font>
                <effect>
                    <DropShadow color="#000000" radius="5.0" />
                </effect>
            </Label>

            <TextField fx:id="txtEmail" prefHeight="35.0" prefWidth="300.0" promptText="Email"
                       style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 0 10 0 10; -fx-border-color: #ffffff; -fx-border-width: 1px;" />

            <PasswordField fx:id="txtPassword" prefHeight="35.0" prefWidth="300.0" promptText="Password"
                           style="-fx-background-radius: 20; -fx-border-radius: 20; -fx-padding: 0 10 0 10; -fx-border-color: #ffffff; -fx-border-width: 1px;" />

            <Button text="Sign In" onAction="#btnOnActionSignIn" prefWidth="300.0" prefHeight="40.0"
                    style="-fx-background-color: #6a11cb; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-weight: bold;" />

            <Button text="Create Account" onAction="#btnOnActionCreateAccount" prefWidth="300.0" prefHeight="40.0"
                    style="-fx-background-color: #2575fc; -fx-text-fill: white; -fx-background-radius: 20; -fx-font-weight: bold;" />

            <Label text="Don't have an account?" textFill="WHITE" alignment="CENTER"/>
        </VBox>
    </children>
</AnchorPane>
