<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.signUpController.SignUpFormController">
   <children>
      <Label alignment="CENTER" layoutX="138.0" layoutY="35.0" prefHeight="41.0" prefWidth="327.0" text="Sign Up Form">
         <font>
            <Font name="System Bold" size="23.0" />
         </font>
      </Label>
      <TextField fx:id="txtFirstName" layoutX="63.0" layoutY="115.0" prefHeight="25.0" prefWidth="199.0" promptText="First Name" />
      <TextField fx:id="txtLastName" layoutX="300.0" layoutY="115.0" prefHeight="25.0" prefWidth="199.0" promptText="Last Name" />
      <TextField fx:id="txtEmail" layoutX="63.0" layoutY="174.0" prefHeight="25.0" prefWidth="439.0" promptText="Email" />
      <PasswordField fx:id="txtPassword" layoutX="64.0" layoutY="230.0" prefHeight="25.0" prefWidth="439.0" promptText="Password" />
      <PasswordField fx:id="txtReEnterPassword" layoutX="63.0" layoutY="281.0" prefHeight="25.0" prefWidth="439.0" promptText="Re-enter Password" />
      <Button layoutX="120.0" layoutY="336.0" mnemonicParsing="false" onAction="#btnOnActionRegister" prefHeight="25.0" prefWidth="141.0" text="Register" />
      <Button layoutX="310.0" layoutY="336.0" mnemonicParsing="false" onAction="#btnOnActionBacktoLogin" prefHeight="25.0" prefWidth="141.0" text="Back to Login" />
   </children>
</AnchorPane>
